# Copy to server/.env for local runs outside Docker. Never commit the real file.
DATABASE_URL=postgresql+psycopg://nowrecommend:nowrecommend@127.0.0.1:5433/nowrecommend
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://ow-wl.github.io"]
# Needed from R4 (AI rerank). Health only reports whether it is set.
GEMINI_API_KEY=
# AI rerank (R4). The API rejects deadlines under 10s; the free tier allows ~5 generate requests/min.
LLM_MODEL=gemini-3.6-flash
RERANK_ENABLED=true
# LLM condition parsing (R5), called only when the rule parser leaves words unexplained.
PARSE_ENABLED=true
RERANK_TIMEOUT_MS=10000
# Set false when deployed (plans-rag.md §12 decision 4).
LOG_RAW_TEXT=true
