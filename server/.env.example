# Copy to server/.env for local runs outside Docker. Never commit the real file.
DATABASE_URL=postgresql+psycopg://nowrecommend:nowrecommend@127.0.0.1:5433/nowrecommend
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://ow-wl.github.io"]
# Needed from R4 (AI rerank). Health only reports whether it is set.
GEMINI_API_KEY=
