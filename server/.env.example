# Copy to server/.env for local runs outside Docker. Never commit the real file.
DATABASE_URL=postgresql+psycopg://nowrecommend:nowrecommend@127.0.0.1:5433/nowrecommend
# JSON array of allowed browser origins.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173","https://ow-wl.github.io"]
# Needed from R4 (AI rerank). Health only reports whether it is set.
GEMINI_API_KEY=
# AI rerank (R4). The API rejects deadlines under 10s; the free tier allows ~5 generate requests/min.
LLM_MODEL=gemini-3.6-flash
RERANK_ENABLED=true
# Music engine (2026-11-02): "ai" = the model names songs itself (falls back to the catalog on failure); "catalog" = retrieval + rerank.
MUSIC_ENGINE=ai
# Models the music lab (#/lab) may use for free AI picks; the first is the default.
LAB_FREE_MODELS=["gemini-3.5-flash-lite","gemini-3.6-flash"]
# Daily calls for each lab model after the first (0 = no cap); protects the small free quota of gemini-3.6-flash.
LAB_EXTRA_MODEL_DAILY_LIMIT=10
# LLM condition parsing (R5), called only when the rule parser leaves words unexplained.
PARSE_ENABLED=true
RERANK_TIMEOUT_MS=10000
# Set false when deployed (plans-rag.md §12 decision 4).
LOG_RAW_TEXT=true
# Per-client POST limit for /api/recommend, /api/parse, the lab and login/signup (0 = off). TRUST_PROXY=true behind a reverse proxy.
# The per-minute limit for a visitor who is not signed in (0 = the same as above). Signed-in callers are counted per account.
RATE_LIMIT_GUEST_PER_MINUTE=15
# Daily limits kept in the database (Korean day; 0 = off). AI_DAILY_LIMIT is the ceiling on model calls for the whole
# service; the other two are one account's and one guest address's requests. Past a limit answers come from the catalog.
AI_DAILY_LIMIT=3000
AI_DAILY_PER_MEMBER=100
AI_DAILY_PER_GUEST=40
SIGNUP_DAILY_PER_ADDRESS=20
# The AI lab is for admin accounts; true opens it to everyone (local experiments without accounts).
LAB_PUBLIC=false
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY=false
# Accounts (2026-11-02). Empty = accounts off (guest-only app). Long random string; rotating it signs everyone out.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=
AUTH_TOKEN_DAYS=30
# Outgoing mail for the password reset link (any SMTP service). Empty SMTP_HOST or MAIL_FROM = reset by mail is off (503).
# Port 465 = TLS from the start; other ports must offer STARTTLS. Keep SMTP_PASSWORD in a secret store, never in git.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Where the app is served; the mailed link opens <PUBLIC_APP_URL>#/reset/<token>.
PUBLIC_APP_URL=http://127.0.0.1:5173/
RESET_TOKEN_MINUTES=30
RESET_DAILY_PER_ADDRESS=10
RESET_DAILY_PER_EMAIL=3
# Saves of the synced store (PUT /api/me/store) per client per minute, counted apart from the limit above (0 = off).
STORE_WRITES_PER_MINUTE=60
STORE_MAX_BYTES=1000000
